     bytesOfInt :: Integer -> [Word8]
     bytesOfInt n = if testBit (head nints) 7 then nints else 0xff : nints
       where
+        nints :: [Word8]
         nints = reverse $ plusOne $ reverse $ map complement $ bytesOfUInt (abs n)
