g :: forall {a}. Num a => a -> a -> a -> a -> a -> a
[GblId, Arity=6, Str=<SP(SC(S,C(1,L)),A,A,A,A,A,A)><L><L><L><L><L>, Unf=Unf{Src=<vanilla>, TopLvl=True, Value=True, ConLike=True, WorkFree=True, Expandable=True, Guidance=IF_ARGS [360 0 0 0 0 0] 160 0}]
g = \ (@a) ($dNum :: Num a) (x1 :: a) (x2 :: a) (x3 :: a) (x4 :: a) (x5 :: a) -> + @a $dNum (+ @a $dNum (+ @a $dNum (+ @a $dNum x1 x2) x3) x4) x5

