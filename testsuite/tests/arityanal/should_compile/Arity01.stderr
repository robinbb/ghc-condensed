-- RHS size: {terms: 37, types: 20, coercions: 0, joins: 1/2}
f1 :: forall {t}. (Ord t, Num t) => t
[GblId, Arity=2, Str=<SP(A,A,SC(S,C(1,L)),A,A,A,A,A)><LP(LC(L,C(1,L)),A,A,A,A,A,L)>, Unf=Unf{Src=<vanilla>, TopLvl=True, Value=True, ConLike=True, WorkFree=True, Expandable=True, Guidance=IF_ARGS [90 450] 240 0}]
f1
  = \ (@t) ($dOrd :: Ord t) ($dNum :: Num t) ->
      let {
        lvl :: t
        [LclId]
        lvl = fromInteger @t $dNum F1.f3 } in
      joinrec {
        h5 [Occ=LoopBreaker, Dmd=SC(S,C(1,C(1,L)))] :: t -> t -> t -> t
        [LclId[JoinId(3)(Nothing)], Arity=3, Str=<L><L><L>, Unf=OtherCon []]
        h5 (n :: t) (x :: t) (eta [OS=OneShot] :: t)
          = case < @t $dOrd x n of {
              False -> eta;
              True -> jump h5 n (+ @t $dNum x lvl) (+ @t $dNum x eta)
            }; } in
      jump h5 (fromInteger @t $dNum F1.f2) lvl (fromInteger @t $dNum F1.f2)

