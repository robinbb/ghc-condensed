F11.$wf11f [InlPrag=[2]] :: forall a p. Num a => a -> a
[GblId[StrictWorker([!])], Arity=2, Str=<SP(SC(S,C(1,L)),A,A,A,A,A,MC(1,L))><L>, Unf=Unf{Src=<vanilla>, TopLvl=True, Value=True, ConLike=True, WorkFree=True, Expandable=True, Guidance=IF_ARGS [270 0] 360 0}]
F11.$wf11f
  = \ (@a) (@p) ($dNum :: Num a) (y :: a) ->
      + @a
        $dNum
        (let {
           lvl :: a
           [LclId]
           lvl = fromInteger @a $dNum F11.f5 } in
         letrec {
           fib2 [Occ=LoopBreaker, Dmd=SC(S,L)] :: Integer -> a
           [LclId, Arity=1, Str=<SL>, Unf=OtherCon []]
           fib2
             = \ (ds :: Integer) ->
                 join {
                   $j [Dmd=ML] :: a
                   [LclId[JoinId(0)(Nothing)]]
                   $j
                     = join {
                         $j1 [Dmd=ML] :: a
                         [LclId[JoinId(0)(Nothing)]]
                         $j1 = + @a $dNum (fib2 (GHC.Internal.Bignum.Integer.integerSub ds F11.f5)) (fib2 (GHC.Internal.Bignum.Integer.integerSub ds F11.f4)) } in
                       case ds of {
                         GHC.Internal.Bignum.Integer.IS x ->
                           case x of {
                             __DEFAULT -> jump $j1;
                             1# -> lvl
                           };
                         GHC.Internal.Bignum.Integer.IP x -> jump $j1;
                         GHC.Internal.Bignum.Integer.IN x -> jump $j1
                       } } in
                 case ds of {
                   GHC.Internal.Bignum.Integer.IS x ->
                     case x of {
                       __DEFAULT -> jump $j;
                       0# -> lvl
                     };
                   GHC.Internal.Bignum.Integer.IP x -> jump $j;
                   GHC.Internal.Bignum.Integer.IN x -> jump $j
                 }; } in
         fib2 F11.f3)
        y

