data S = MkS { foo :: Int }
data T a = MkT { foo :: Bool, bar :: a -> a }
let t = MkT { foo = True, bar = id }
(\MkT{foo=foo} -> foo) t
:info foo
bar (MkT True id) True
-- Should be ambiguous
:type foo
data U = MkU { foo :: Int }
-- The new foo does not shadow the old ones: still ambiguous
:info foo
:type foo
foo (MkU 42)
