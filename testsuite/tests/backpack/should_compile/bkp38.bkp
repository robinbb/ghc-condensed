{-# LANGUAGE Haskell2010 #-}
{-# LANGUAGE FlexibleInstances #-}
{-# LANGUAGE RoleAnnotations #-}
unit p where
    signature A where
        import Data.Kind (Type)
        type role K nominal
        data K (a :: Type)
        instance Show (K Int)
        instance Show (K Bool)
unit q where
    module A where
        import Data.Kind (Type)
        type role T representational nominal
        data T a (b :: Type) = MkT
            deriving (Show)
        type K = T ()
unit r where
    dependency p[A=q:A]
