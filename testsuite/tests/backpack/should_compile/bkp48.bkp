{-# LANGUAGE Haskell2010 #-}
{-# LANGUAGE TypeFamilies #-}
unit p where
    signature A where
        import Data.Kind (Type)
        type family K (a :: Type) :: Type where ..

unit q where
    signature A where
        import Data.Kind (Type)
        type family K (a :: Type) :: Type where
            K a = Int

unit r where
    dependency p[A=<A>]
    dependency q[A=<A>]

unit i where
    module A where
        import Data.Kind (Type)
        type family K (a :: Type) :: Type where
            K a = Int

unit m where
    dependency r[A=i:A]
    dependency p[A=i:A]
    dependency q[A=i:A]
