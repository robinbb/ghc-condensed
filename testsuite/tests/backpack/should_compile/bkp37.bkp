{-# LANGUAGE Haskell2010 #-}
{-# LANGUAGE FlexibleInstances #-}
unit p where
    signature A where
        import Data.Kind (Type)
        data K (a :: Type)
        instance Show (K Int)
        instance Show (K Bool)
unit q where
    module A where
        type K = []
unit r where
    dependency p[A=q:A]
